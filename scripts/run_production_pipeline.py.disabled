#!/usr/bin/env python3
"""
Master Production Pipeline Runner for SENTINEL-Vision / ARG-VRI 2.0.

Executes:
1. Stage A Training (Obvious Harm - Destructive)
2. Stage B Training (Multi-Category - Financial & Privacy)
3. Stage C Training (Contextual Edge Cases + MisActBench Gold Integration)
4. Dedicated Localization Fine-Tuning (Quality Focal Loss + CIoU)
5. Full End-to-End Evaluation Suite:
   - Final Held-Out Test Split Metrics (evaluate_final.py)
   - MisActBench Gold Label Evaluation (eval_misactbench_gold.py)
   - ScreenSpot-v2 Grounding Evaluation (eval_screenspot.py)

Usage:
    python scripts/run_production_pipeline.py --batch-size 8 --stage-a-epochs 5 --stage-b-epochs 5 --stage-c-epochs 8
"""

import argparse
import json
import logging
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(message)s",
    handlers=[
        logging.StreamHandler(sys.stdout),
        logging.FileHandler(ROOT / "production_pipeline.log", mode="a", encoding="utf-8"),
    ],
)
logger = logging.getLogger("ProductionPipeline")


def run_cmd(cmd_list, desc):
    """Run a subprocess command and stream logs in real time."""
    logger.info("=" * 70)
    logger.info(f"Starting: {desc}")
    logger.info(f"Command: {' '.join(str(c) for c in cmd_list)}")
    logger.info("=" * 70)

    start_time = time.time()
    proc = subprocess.Popen(
        cmd_list,
        cwd=str(ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        encoding="utf-8",
        errors="replace",
    )

    for line in proc.stdout:
        line_str = line.strip()
        if line_str:
            logger.info(f"[{desc}] {line_str}")

    proc.wait()
    elapsed = time.time() - start_time

    if proc.returncode != 0:
        logger.error(f"FAILED: {desc} exited with code {proc.returncode} after {elapsed:.1f}s")
        raise RuntimeError(f"{desc} failed with exit code {proc.returncode}")

    logger.info(f"COMPLETED: {desc} in {elapsed:.1f}s ({elapsed/60:.2f} mins)")
    return elapsed


def main():
    parser = argparse.ArgumentParser(description="Run Production Pipeline for SENTINEL-Vision.")
    parser.add_argument("--batch-size", type=int, default=8, help="Batch size for training.")
    parser.add_argument("--stage-a-epochs", type=int, default=5, help="Number of epochs for Stage A.")
    parser.add_argument("--stage-b-epochs", type=int, default=5, help="Number of epochs for Stage B.")
    parser.add_argument("--stage-c-epochs", type=int, default=8, help="Number of epochs for Stage C.")
    parser.add_argument("--loc-epochs", type=int, default=4, help="Number of epochs for localization fine-tuning.")
    parser.add_argument("--stages", default="a,b,c,loc,eval", help="Comma-separated stages to run: a,b,c,loc,eval")
    parser.add_argument("--device", default="cuda", help="Compute device (cuda/cpu).")
    args = parser.parse_args()

    active_stages = set(s.strip().lower() for s in args.stages.split(","))
    results_dir = ROOT / "results"
    results_dir.mkdir(parents=True, exist_ok=True)
    timing_records = {}

    logger.info("*" * 70)
    logger.info("SENTINEL-Vision Production Pipeline Orchestrator")
    logger.info(f"Active Stages: {active_stages}")
    logger.info(f"Batch Size: {args.batch_size} | Device: {args.device}")
    logger.info("*" * 70)

    # 1. Stage A
    if "a" in active_stages:
        cmd = [
            sys.executable, "-m", "src.training.train_stageA",
            f"device={args.device}",
            f"training.batch_size={args.batch_size}",
            f"training.epochs={args.stage_a_epochs}",
            "+synthetic_injection_dir=data/__no_synthetic__",
        ]
        timing_records["stage_a"] = run_cmd(cmd, "Stage A Training (Obvious Harm)")

    # 2. Stage B
    if "b" in active_stages:
        cmd = [
            sys.executable, "-m", "src.training.train_stageB",
            f"device={args.device}",
            f"training.batch_size={args.batch_size}",
            f"training.epochs={args.stage_b_epochs}",
            "+synthetic_injection_dir=data/__no_synthetic__",
        ]
        timing_records["stage_b"] = run_cmd(cmd, "Stage B Training (Financial & Privacy)")

    # 3. Stage C
    if "c" in active_stages:
        cmd = [
            sys.executable, "-m", "src.training.train_stageC",
            f"device={args.device}",
            f"training.batch_size={args.batch_size}",
            f"training.epochs={args.stage_c_epochs}",
            "+synthetic_injection_dir=data/__no_synthetic__",
        ]
        timing_records["stage_c"] = run_cmd(cmd, "Stage C Training (Contextual Edge Cases)")

    # 4. Localization Fine-Tuning
    if "loc" in active_stages:
        ckpt = ROOT / "checkpoints" / "stage_c" / "best_loc.pt"
        if not ckpt.exists():
            ckpt = ROOT / "checkpoints" / "stage_c" / "latest.pt"
        cmd = [
            sys.executable, "scripts/finetune_localization.py",
            "--checkpoint", str(ckpt),
            "--epochs", str(args.loc_epochs),
            "--batch-size", str(args.batch_size),
            "--device", args.device,
        ]
        timing_records["localization"] = run_cmd(cmd, "Dedicated Localization Fine-Tuning")

    # 5. Full Evaluation Suite
    if "eval" in active_stages:
        eval_ckpt = ROOT / "checkpoints" / "localization_finetune" / "best.pt"
        if not eval_ckpt.exists():
            eval_ckpt = ROOT / "checkpoints" / "stage_c" / "best_loc.pt"
        if not eval_ckpt.exists():
            eval_ckpt = ROOT / "checkpoints" / "stage_c" / "latest.pt"

        # 5a. Final test metrics
        cmd = [
            sys.executable, "scripts/evaluate_final.py",
            "--checkpoint", str(eval_ckpt),
            "--out", "results/final_test_metrics_best_loc.json",
        ]
        timing_records["eval_final"] = run_cmd(cmd, "Test Split Evaluation (evaluate_final.py)")

        # 5b. MisActBench gold evaluation
        cmd = [
            sys.executable, "scripts/eval_misactbench_gold.py",
            "--checkpoint", str(eval_ckpt),
            "--out", "results/misactbench_gold_eval.json",
        ]
        timing_records["eval_misactbench"] = run_cmd(cmd, "MisActBench Gold Evaluation")

        # 5c. ScreenSpot-v2 evaluation
        cmd = [
            sys.executable, "scripts/eval_screenspot.py",
            "--checkpoint", str(eval_ckpt),
            "--out", "results/screenspot_v2_point_accuracy.json",
        ]
        timing_records["eval_screenspot"] = run_cmd(cmd, "ScreenSpot-v2 Point Accuracy Evaluation")

    summary_file = results_dir / "production_pipeline_summary.json"
    with open(summary_file, "w", encoding="utf-8") as f:
        json.dump({
            "completed_at": datetime.now().isoformat(),
            "active_stages": list(active_stages),
            "batch_size": args.batch_size,
            "timing_records_seconds": timing_records,
            "total_runtime_minutes": sum(timing_records.values()) / 60,
        }, f, indent=2)

    logger.info("=" * 70)
    logger.info(f"Production pipeline completed in {sum(timing_records.values())/60:.2f} mins.")
    logger.info(f"Summary written to: {summary_file}")
    logger.info("=" * 70)


if __name__ == "__main__":
    main()
