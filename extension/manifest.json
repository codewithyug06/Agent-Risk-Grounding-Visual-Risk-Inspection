{
  "manifest_version": 3,
  "name": "SENTINEL-Vision Agent Monitor",
  "version": "0.1.0",
  "description": "Watches your active tab for risky AI-agent actions via a local SENTINEL-Vision gateway and flags/blocks them before they execute.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "tabs", "storage", "scripting", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "options_page": "options.html"
}
